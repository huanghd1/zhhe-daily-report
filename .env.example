# 本地运行 npm run update 时读取；GitHub Actions 不读此文件，改用仓库 Secrets / Variables
# 大模型使用 OpenAI 兼容协议，请求 ${LLM_BASE_URL}/chat/completions
# DeepSeek：LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
# Kimi：    LLM_BASE_URL=https://api.moonshot.cn/v1   LLM_MODEL=kimi-k3.1-pro
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 可选：GitHub Search API 匿名请求每分钟只有 10 次，被限流时可填一个无需任何权限的 token
# GITHUB_TOKEN=
